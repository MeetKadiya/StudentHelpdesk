# Copy to docker/.env for local dev (docker compose auto-loads .env next to
# the compose file). Never commit the real .env. These are infra-level
# credentials for the compose stack itself — application config for the
# backend lives in backend/.env (see backend/.env.example), not here.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=helpdesk

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

GRAFANA_ADMIN_PASSWORD=admin
