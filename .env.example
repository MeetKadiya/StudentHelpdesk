# Root env template — copy to .env for docker-compose. Service-specific
# .env.example files also exist (e.g. backend/.env.example) for running
# components outside Docker.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/helpdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=helpdesk

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me

# --- AI providers (abstracted — see agents/ once implemented) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Email (Resend primary, SMTP fallback) ---
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Object storage (MinIO / S3-compatible) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=helpdesk-attachments

# --- Analytics ---
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
