# Copy to agents/.env for local dev. Never commit the real .env.
#
# See agents/config.py's module docstring: docker-compose.yml currently
# feeds the ai-worker service from ../backend/.env instead of this file,
# flagged there as a temporary/undecided wiring choice pending AI-04. This
# file documents the variables agents/ actually reads either way.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

CONFIDENCE_ESCALATION_THRESHOLD=0.6
GRAPH_VERSION=v1

# AI-02 — rag/ ingestion (see agents/rag/ingest.py)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
FAISS_INDEX_PATH=knowledgebase/embeddings/index.faiss
FAISS_METADATA_PATH=knowledgebase/metadata/chunks.jsonl

# AI-04 — ai-worker (see agents/worker/)
REDIS_URL=redis://redis:6379/0
AI_TASK_QUEUE=ai_tasks
BACKEND_INTERNAL_BASE_URL=http://fastapi-backend:8000
BACKEND_WRITE_BACK_TIMEOUT_SECONDS=10.0
